PORT=3001
APP_URL=https://pulse-messenger.com
WEB_APP_URL=https://web.pulse-messenger.com
# Komma-gescheiden lijst met extra toegestane frontend origins voor CORS:
# CORS_ORIGINS=https://staging.pulse-messenger.com,http://localhost:3000
# Optioneel: sta preview-subdomeinen toe op host-suffix niveau:
# CORS_ORIGIN_SUFFIXES=.pulse-frontend-elt.pages.dev
# App-only endpoints en sockets vertrouwen WEB_APP_URL; laat APP_URL marketing-only.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optioneel voor lokale attachment mock-storage:
# PULSE_ATTACHMENT_MOCK_DIR=/tmp/pulse-e2ee-attachments
# Transactionele e-mail (Resend) voor verificatiecodes:
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=Pulse <no-reply@jouwdomein.nl>
# RESEND_REPLY_TO=support@jouwdomein.nl
# Alleen voor lokaal testen zonder echte Firebase token:
# ALLOW_DEV_AUTH_BYPASS=true
# Of lokaal tegen Firestore Emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=pulse-messenger-3cb9d
# Snelle shortcut via npm scripts:
# npm run preflight:emulator
# npm run seed:emulator
# npm run dev:emulator
# Of gebruik Railway-vriendelijke secrets:
# FIREBASE_SERVICE_ACCOUNT_JSON={"projectId":"...","clientEmail":"...","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Of losse env-velden:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WebRTC ICE/TURN configuratie (optioneel maar aanbevolen voor mobiel/strenge NAT):
# Optie A: volledige ICE lijst als JSON-array
# ICE_SERVERS_JSON=[{"urls":"turn:global.relay.metered.ca:80","username":"user","credential":"pass"},{"urls":"turns:global.relay.metered.ca:443?transport=tcp","username":"user","credential":"pass"}]
#
# Optie B: losse TURN variabelen (automatisch gecombineerd met STUN fallback)
# TURN_URLS=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=your_turn_username
# TURN_PASSWORD=your_turn_password
