rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Gebruikers ────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Iedereen ingelogd mag basisinfo lezen (displayName, photoURL, online)
      allow read: if request.auth != null;

      // Alleen eigen document aanmaken bij registratie
      allow create: if request.auth != null && request.auth.uid == uid
        && !('role'            in request.resource.data)
        && !('parentId'        in request.resource.data)
        && !('pausedFeatures'  in request.resource.data);

      // Eigen document bijwerken — beschermde velden alleen via backend (Admin SDK)
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'parentId', 'paused', 'pausedFeatures', 'online', 'inactive', 'lastSeen']);

      // Verwijderen alleen via backend
      allow delete: if false;

      // Contacten subcollectie — alleen eigen contacten
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Nicknames subcollectie — alleen eigen nicknames
      match /nicknames/{contactUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Gesprekken ────────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Aanmaken/bijwerken/verwijderen alleen via backend
      allow create, update, delete: if false;

      // Berichten — alleen leden mogen lezen
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.members;
        allow write: if false;
      }
    }

    // ── Sessies (ouderlijk toezicht) ──────────────────────────────────────────
    match /userSessions/{sessionId} {
      // Kind mag eigen sessies lezen, ouder mag sessies van zijn kind lezen
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.uid
          || request.auth.uid == resource.data.parentId);
      allow write: if false;
    }

    // ── Vriendverzoeken ───────────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      // Alleen verzender of ontvanger mag lezen
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid);
      // Schrijven alleen via backend
      allow write: if false;
    }

    // ── Ouder activiteiten ────────────────────────────────────────────────────
    match /parentActivities/{docId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.parentId;
      allow write: if false;
    }

    // ── Alles anders: geblokkeerd ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
